#!/usr/bin/env python3
"""git-timeline — backfill and render the agent git-operation log.

The live half is hooks/git-ops.py, which appends one row per git invocation to
~/.claude/git-ops.jsonl as agents work. This is the other half:

  git-timeline backfill        # import git calls from past Claude transcripts (idempotent)
  git-timeline html [--open]   # render a self-contained timeline page (a snapshot)
        [--repo NAME]          #   repo the page opens on (default: the repo you run it from)
        [--out PATH]           #   default ~/.claude/git-timeline.html
        [--no-prs]             #   skip asking GitHub (via `gh`) for pull requests
  git-timeline serve [--open]  # the same page, live: http://127.0.0.1:8390/git-timeline.html
        [--port N]             #   a fixed port instead of the first free one in 8390-8399

Both keep ~/.claude/git-timeline-cache.json: each repo's graph and push history,
reused until that repo's refs move, and GitHub's PR lists for ten minutes. Only
the first build ever is slow; delete the file to start cold.

Backfill reads ~/.claude/projects/**.jsonl — main sessions and subagents — and
pairs each Bash tool_use with its tool_result for the exit status. Rows are
keyed by tool_use_id, so a call the hook already logged is never logged twice
and re-running backfill adds nothing. Transcripts are pruned after
`cleanupPeriodDays`; the log is not, so backfill early.

The page is local only and never published: the log holds commit messages and
paths. It embeds its data, so it opens from disk with no server.
"""

import argparse
import datetime
import hashlib
import http.server
import importlib.util
import json
import os
import re
import shlex
import shutil
import socket
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from collections import Counter

HERE = os.path.dirname(os.path.realpath(__file__))
_spec = importlib.util.spec_from_file_location("git_ops", os.path.join(HERE, "..", "hooks", "git-ops.py"))
git_ops = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(git_ops)

CLAUDE = os.path.join(os.path.expanduser("~"), ".claude")


def read_log(path):
    """Rows of the log, with `{"id", "patch"}` lines merged into the row they name.

    The log is append-only; a patch is how a later backfill adds a field (the
    commits a call made) to a row written before that field existed.
    """
    rows, patches = [], []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue            # a torn line from a killed writer
                if isinstance(r, dict) and r.get("id"):
                    (patches if "patch" in r else rows).append(r)
    except FileNotFoundError:
        pass
    by_id = {r["id"]: r for r in rows}
    for p in patches:
        if p["id"] in by_id and isinstance(p["patch"], dict):
            by_id[p["id"]].update(p["patch"])
    return rows


def _text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(b.get("text", "") for b in content if isinstance(b, dict))
    return ""


def transcripts(root):
    for d, _, files in os.walk(root):
        for f in files:
            if f.endswith(".jsonl"):
                yield os.path.join(d, f)


def scan(path):
    """(entry, tool_use block, result-or-None) for each Bash call with git in it."""
    calls, results = [], {}
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return []
    with fh:
        for line in fh:
            if '"tool_' not in line:
                continue
            try:
                e = json.loads(line)
            except ValueError:
                continue
            msg = e.get("message")
            content = msg.get("content") if isinstance(msg, dict) else None
            if not isinstance(content, list):
                continue
            for b in content:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "tool_use" and b.get("name") == "Bash":
                    if "git" in ((b.get("input") or {}).get("command") or ""):
                        calls.append((e, b))
                elif b.get("type") == "tool_result":
                    results[b.get("tool_use_id")] = b
    return [(e, b, results.get(b.get("id"))) for e, b in calls]


def backfill(args):
    seen = {r["id"]: r for r in read_log(args.log)}
    new, patches = [], []
    for path in transcripts(args.projects):
        sub = os.sep + "subagents" + os.sep in path
        for e, b, res in scan(path):
            ok = None if res is None else not res.get("is_error", False)
            err = _text(res.get("content")).strip() if res is not None and not ok else None
            agent = e.get("agentId") or (os.path.basename(path)[:-6].replace("agent-", "") if sub else None)
            text = _text(res.get("content")) if res is not None else None
            made = git_ops.made_commits(text) if ok else []
            rows = git_ops.rows_for(b["input"]["command"], e.get("cwd") or "/", rid=b.get("id"),
                                    ts=e.get("timestamp"), session=e.get("sessionId"), agent=agent,
                                    ok=ok, error=err, src="backfill", branch_hint=e.get("gitBranch"),
                                    made=made or None, out_chars=len(text) if text is not None else None)
            for r in rows:
                old = seen.get(r["id"])
                if old is None:
                    seen[r["id"]] = r
                    new.append(r)
                    continue
                # Fields an older row predates: the sha it made, and the sizes the token estimate needs.
                patch = {k: r[k] for k in ("made", "out_chars", "cmd_chars", "calln") if r.get(k) is not None and old.get(k) is None}
                if r.get("calln") is not None and old.get("calln") is not None and r["calln"] > old["calln"]:
                    patch["calln"] = r["calln"]         # an earlier count saw only the git commands: only ever too low
                if patch:
                    old.update(patch)
                    patches.append({"id": r["id"], "patch": patch})
    new.sort(key=lambda r: r["ts"] or "")
    git_ops.append(new + patches, args.log)
    if patches:
        print(f"backfill: {len(patches)} earlier row(s) patched with fields they predate")
    by_repo = Counter(r["repo"] for r in new)
    print(f"backfill: {len(new)} new git op(s) -> {args.log}")
    for repo, n in by_repo.most_common():
        print(f"  {n:6d}  {repo}")


def _here_repo():
    try:
        p = subprocess.run(["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
                           capture_output=True, text=True, encoding="utf-8", timeout=3)
    except (OSError, subprocess.SubprocessError):
        return None
    common = p.stdout.strip()
    if p.returncode or not common:
        return None
    return os.path.basename(os.path.dirname(common) if os.path.basename(common) == ".git" else common)


def _git(root, *args):
    try:
        p = subprocess.run(["git", "-C", root, *args], capture_output=True, text=True,
                           encoding="utf-8", errors="replace", timeout=60)
    except (OSError, subprocess.SubprocessError):
        return ""
    return p.stdout if p.returncode == 0 else ""


def pull_requests(root):
    """Every PR of the repo's GitHub origin, via `gh`; [] when there is no GitHub remote or no gh."""
    m = re.search(r"github\.com[:/](.+?)(?:\.git)?/?$", _git(root, "remote", "get-url", "origin").strip())
    if not m:
        return []
    try:
        p = subprocess.run(["gh", "pr", "list", "-R", m.group(1), "--state", "all", "--limit", "1000", "--json",
                            "number,title,headRefName,baseRefName,state,createdAt,mergedAt,closedAt,mergeCommit"],
                           capture_output=True, text=True, encoding="utf-8", timeout=60)
        prs = json.loads(p.stdout) if p.returncode == 0 else []
    except (OSError, subprocess.SubprocessError, ValueError):
        return []
    return [{"n": pr["number"], "title": pr["title"][:140], "head": pr["headRefName"], "base": pr["baseRefName"],
             "state": pr["state"].lower(), "created": pr["createdAt"], "merged": pr.get("mergedAt"),
             "closed": pr.get("closedAt"), "mergeOid": ((pr.get("mergeCommit") or {}).get("oid") or "")[:12] or None}
            for pr in prs]


def repo_graph(root, prs=True):
    """The commit DAG the journey view draws: [sha, parents, unix time, refs, subject, by_github].

    Branches, remote branches and tags, not `--all`: that would drag every stash
    in as a branch. Worktree branches are ordinary branches, so they come along.
    """
    out = _git(root, "log", "--branches", "--remotes", "--tags", "HEAD", "--date-order",
               "--format=%H%x1f%P%x1f%ct%x1f%D%x1f%s%x1f%ce%x1e")
    commits = []
    for rec in out.split("\x1e"):
        f = rec.strip("\n").split("\x1f")
        if len(f) < 6:
            continue
        refs = [r.replace("HEAD -> ", "") for r in f[3].split(", ")
                if r and r != "HEAD" and not r.endswith("/HEAD")]
        commits.append([f[0][:12], [x[:12] for x in f[1].split()], int(f[2]), refs, f[4][:140],
                        1 if f[5].endswith("noreply@github.com") else 0])
    names = {r for c in commits for r in c[3]}
    default = _git(root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD").strip().split("/", 1)[-1]
    if default not in names and "origin/" + default not in names:
        default = next((b for b in ("main", "master", "trunk") if b in names or "origin/" + b in names), None)
    return {"commits": commits, "default": default, "prs": pull_requests(root) if prs and commits else []}


def sync_events(root, default=None, keep=200):
    """Every push and every fetch/pull the remote-tracking refs remember, with the commits each carried.

    Git's own record, not a parse of command output: each update to
    refs/remotes/* lands in that ref's reflog with a time and a reason
    ("update by push", "fetch: fast-forward", "pull: ..."), so old..new is
    exactly what moved. A force push is logged as a plain "update by push";
    it shows up as commits the old tip had and the new one lacks.
    Reflogs expire (90 days by default), so this reaches back that far.
    """
    refs = [r for r in _git(root, "for-each-ref", "--format=%(refname)", "refs/remotes").split()
            if not r.endswith("/HEAD")]
    logs = {}
    for ref in refs:
        entries = []
        for line in _git(root, "reflog", "show", "--date=unix", "--format=%H%x1f%gd%x1f%gs", ref).splitlines():
            f = line.split("\x1f")
            m = re.search(r"@\{(\d+)\}$", f[1]) if len(f) == 3 else None
            if m:
                entries.append((f[0], int(m.group(1)), f[2]))
        logs[ref] = entries[::-1]                   # oldest first
    base_ref = f"refs/remotes/origin/{default}" if default else None

    def base_at(t):
        """The default branch's remote tip as of `t`: what a brand-new branch is measured against."""
        val = None
        for h, ts, _ in logs.get(base_ref, []):
            if ts <= t:
                val = h
        return val

    events = []
    for ref, entries in logs.items():
        prev = None
        for h, t, msg in entries:
            how = ("push" if msg.startswith("update by push") else "pull" if msg.startswith("pull")
                   else "fetch" if msg.startswith("fetch") else None)
            old, prev = prev, h
            if how is None or h == old:
                continue                            # clone, rename, or a no-op update
            # A branch carries only what main did not already have: a rebase onto main, or a new
            # branch, would otherwise count every main commit it was rebased over or cut from.
            b = base_at(t) if ref != base_ref else None
            not_base = [f"^{b}"] if b and b != h else []
            rng = ([f"{old}..{h}"] if old else [h]) + not_base
            commits = [c.split("\x1f") for c in _git(root, "log", "--format=%H%x1f%s%x1f%ct", *rng, "--").splitlines()]
            commits = [c for c in commits if len(c) == 3]
            dropped = int(_git(root, "rev-list", "--count", f"{h}..{old}", *not_base).strip() or 0) if old else 0
            if not commits and not dropped:
                continue
            events.append({"t": t, "ref": ref[len("refs/remotes/"):], "how": how, "old": old[:12] if old else None,
                           "new": h[:12], "n": len(commits), "forced": dropped > 0, "dropped": dropped,
                           "commits": [[c[0][:12], c[1][:120], int(c[2])] for c in commits[:keep]]})
    events.sort(key=lambda e: e["t"], reverse=True)
    return events


def _msg_of(argv):
    """The `-m` message of a commit command line, if it has one."""
    try:
        toks = shlex.split(argv or "")
    except ValueError:
        return None
    for i, t in enumerate(toks):
        if t.startswith("--message="):
            return t.split("=", 1)[1]
        if (t == "--message" or re.fullmatch(r"-[a-zA-Z]*m", t)) and i + 1 < len(toks):
            return toks[i + 1]
        if re.fullmatch(r"-m.+", t):
            return t[2:]
    return None


def commit_authors(graph, rows, window=300):
    """Which chat made each commit: {sha: {s: session, a: subagent, how, alt}}.

    Strongest evidence first. `exact` — the op's own output or the worktree's
    HEAD named the sha. `message` — a `-m` whose first line is the subject.
    `time` — the only chat that ran a commit-creating op within `window`
    seconds. `ambiguous` — several did; the nearest is named and `alt` says how
    many others were in the running. Commits GitHub made (PR merges on the site)
    are skipped, and no op in range means no entry: made outside any logged chat.
    """
    ops = [(_epoch(r.get("ts")), r) for r in rows
           if r.get("sub") in git_ops.CREATORS and r.get("ok") is not False]
    ops = [(t, r) for t, r in ops if t is not None]
    exact = {sha[:7]: r for _, r in ops for sha in r.get("made") or []}
    out = {}
    for c in graph["commits"]:
        sha, ct, subj, by_github = c[0], c[2], c[4], len(c) > 5 and c[5]
        if by_github:
            continue
        r = exact.get(sha[:7])
        if r:
            out[sha] = {"s": r.get("session"), "a": r.get("agent"), "how": "exact"}
            continue
        near = [(abs(t - ct), r) for t, r in ops if abs(t - ct) <= window]
        if not near:
            continue
        said = [(d, r) for d, r in near
                if (m := _msg_of(r.get("argv"))) and m.strip().splitlines()[0][:140].strip() == subj.strip()]
        if said:
            r = min(said, key=lambda x: x[0])[1]
            out[sha] = {"s": r.get("session"), "a": r.get("agent"), "how": "message"}
            continue
        d, r = min(near, key=lambda x: x[0])
        others = {x.get("session") for _, x in near} - {r.get("session")}
        out[sha] = {"s": r.get("session"), "a": r.get("agent"), "how": "ambiguous" if others else "time",
                    "alt": len(others)}
    return out


def session_titles(projects):
    """{session id: chat title}: the latest custom title, else the AI title, else the last prompt."""
    found = {}
    for path in transcripts(projects):
        if os.sep + "subagents" + os.sep in path:
            continue
        try:
            fh = open(path, encoding="utf-8", errors="replace")
        except OSError:
            continue
        with fh:
            for line in fh:
                if '"custom-title"' not in line and '"ai-title"' not in line and '"last-prompt"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except ValueError:
                    continue
                val = d.get("customTitle") or d.get("aiTitle") or d.get("lastPrompt")
                if d.get("sessionId") and val:
                    found.setdefault(d["sessionId"], {})[d.get("type")] = val     # later lines win
    return {sid: (b.get("custom-title") or b.get("ai-title") or b.get("last-prompt")).strip()[:90]
            for sid, b in found.items()}


def _epoch(ts):
    try:
        return datetime.datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
    except (AttributeError, ValueError):
        return None


def attribute(events, rows, window=180):
    """Name the session behind each event, and add the pushes that failed (the reflog never sees those).

    An event is matched to the nearest git op of the same kind in the same repo
    within `window` seconds. No match means it ran outside any logged agent
    session: you in a terminal, an IDE, or a sync tool.
    """
    ops = [(_epoch(r["ts"]), r) for r in rows if r.get("sub") in ("push", "fetch", "pull")]
    ops = [(t, r) for t, r in ops if t is not None]
    for ev in events:
        kinds = ("push",) if ev["how"] == "push" else ("fetch", "pull")
        near = [(abs(t - ev["t"]), r) for t, r in ops if r["sub"] in kinds and r.get("ok") is not False
                and abs(t - ev["t"]) <= window]
        if near:
            r = min(near, key=lambda x: x[0])[1]
            ev.update(session=r.get("session"), agent=r.get("agent"), argv=r.get("argv"))
    for t, r in ops:
        if r["sub"] == "push" and r.get("ok") is False:
            events.append({"t": int(t), "ref": r.get("branch") or "?", "how": "push", "failed": True, "n": 0,
                           "forced": False, "dropped": 0, "commits": [], "session": r.get("session"),
                           "agent": r.get("agent"), "argv": r.get("argv"), "error": (r.get("error") or "")[:200]})
    events.sort(key=lambda e: e["t"], reverse=True)
    return events


KEEP = ("ts", "session", "agent", "repo", "worktree", "branch", "sub", "cat", "argv", "ok", "error",
        "out_chars", "cmd_chars", "calln")


PR_TTL = 600          # seconds a repo's PR list is reused by `serve`: GitHub is the slow part
DATA_TTL = 30         # seconds `serve` reuses a built payload; the page polls on the same beat
HOME_PORT, PORT_SPAN = 8390, 10   # beside the mow tracker's 8300-8379, never inside it


def _prs(root, args, memo):
    if args.no_prs:
        return []
    key = "prs\u0000" + root
    if memo is not None:
        hit = memo.get(key)
        if hit and time.time() - hit[0] < PR_TTL:
            return hit[1]
    prs = pull_requests(root)
    if memo is not None:
        memo[key] = [time.time(), prs]
    return prs


TITLES_TTL = 300      # seconds `serve` reuses chat titles; scanning every transcript costs seconds


def _cached(memo, key, fingerprint, compute):
    """`compute()`, reused from `memo` while `fingerprint` is unchanged. No memo, no caching."""
    if memo is None:
        return compute()
    key = key if isinstance(key, str) else "\u0000".join(key)    # JSON keys, for the file
    hit = memo.get(key)
    if hit is not None and hit[0] == fingerprint:
        return hit[1]
    value = compute()
    memo[key] = [fingerprint, value]
    return value


def load_memo(path):
    """The cache saved by the last build, or an empty one. A damaged file is just a cold start."""
    try:
        with open(path, encoding="utf-8") as fh:
            memo = json.load(fh)
    except (OSError, ValueError):
        return {}
    return memo if isinstance(memo, dict) else {}


def save_memo(memo, path):
    """Write atomically, owner-only: it holds commit subjects and repo paths."""
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(memo, fh, ensure_ascii=False, separators=(",", ":"))
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except OSError:
        try:
            os.remove(tmp)
        except OSError:
            pass


def _refs_fingerprint(root):
    """Changes whenever any ref of `root` moves: every commit, fetch, push, reset and branch
    update writes a reflog or a ref file, so their sizes and times are the repo's pulse.
    Costs one git call and a directory walk, against seconds for the graph and push history."""
    common = _git(root, "rev-parse", "--path-format=absolute", "--git-common-dir").strip()
    if not common:
        return None
    parts = []
    for sub in ("logs", "refs", "worktrees"):
        for d, _, files in os.walk(os.path.join(common, sub)):
            for f in files:
                try:
                    st = os.stat(os.path.join(d, f))
                except OSError:
                    continue
                parts.append((d[len(common):], f, st.st_mtime_ns, st.st_size))
    try:
        st = os.stat(os.path.join(common, "packed-refs"))
        parts.append(("", "packed-refs", st.st_mtime_ns, st.st_size))
    except OSError:
        pass
    # sha1, not hash(): the fingerprint is saved to disk, and hash() differs per process
    return hashlib.sha1(repr(sorted(parts)).encode("utf-8")).hexdigest()


def build_data(args, memo=None):
    """Everything the page draws: log rows, per-repo graphs, chat titles. Shared by `html` and `serve`.

    `serve` passes a `memo`: each repo's graph and push history are then rebuilt only when
    that repo's refs moved, which takes a rebuild from ~20 s to about one."""
    rows, ids = [], set()
    for r in read_log(args.log):
        if r["id"] in ids or not r.get("ts"):
            continue
        ids.add(r["id"])
        slim = {k: r.get(k) for k in KEEP if r.get(k) is not None}
        cmd = r.get("command") or ""
        if cmd and cmd.strip() != (r.get("argv") or ""):
            slim["cmd"] = cmd[:600]
        rows.append(slim)
    rows.sort(key=lambda r: r["ts"])
    repos = Counter(r["repo"] for r in rows)
    full = read_log(args.log)
    roots = {}
    for r in full:
        if r.get("root"):
            roots.setdefault(r["repo"], Counter())[r["root"]] += 1
    graphs = {}
    for repo, seen in roots.items():
        root = next((p for p, _ in seen.most_common() if os.path.isdir(p)), None)
        if root:
            fp = _refs_fingerprint(root) if memo is not None else None
            graph = _cached(memo, ("graph", root), fp, lambda: repo_graph(root, prs=False))
            graphs[repo] = dict(graph)
            graphs[repo]["prs"] = _prs(root, args, memo) if graph["commits"] else []
            events = _cached(memo, ("sync", root), fp, lambda: sync_events(root, graph["default"]))
            # attribute() edits its list in place, so it gets copies, never the cached events
            graphs[repo]["sync"] = attribute([dict(e) for e in events], [r for r in rows if r["repo"] == repo])
            graphs[repo]["authors"] = commit_authors(graphs[repo], [r for r in full if r.get("repo") == repo])
    sessions = {r.get("session") for r in rows}
    every = _cached(memo, "titles", int(time.time() // TITLES_TTL) if memo is not None else None,
                    lambda: session_titles(args.projects))
    titles = {k: v for k, v in every.items() if k in sessions}
    default = args.repo or _here_repo()
    if default not in repos:
        default = repos.most_common(1)[0][0] if repos else None
    return {"rows": rows, "graphs": graphs, "titles": titles, "defaultRepo": default, "generated": git_ops.now()}


def html(args):
    memo = load_memo(args.cache)
    d = build_data(args, memo)
    save_memo(memo, args.cache)
    rows, graphs, default = d["rows"], d["graphs"], d["defaultRepo"]
    repos = {r["repo"] for r in rows}
    data = json.dumps(d, ensure_ascii=False, separators=(",", ":"))
    # `</` inside a <script> block ends it, whatever JSON thinks; commit messages carry it.
    data = data.replace("<", "\\u003c")
    with open(os.path.join(HERE, "git-timeline.html"), encoding="utf-8") as fh:
        page = fh.read().replace("/*__DATA__*/null", data)
    os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
    with open(args.out, "w", encoding="utf-8") as fh:
        fh.write(page)
    # The page links its guide by a relative path, so the guide goes wherever the page goes.
    shutil.copyfile(os.path.join(HERE, "git-timeline-guide.html"),
                    os.path.join(os.path.dirname(os.path.abspath(args.out)), "git-timeline-guide.html"))
    print(f"html: {len(rows)} op(s) across {len(repos)} repo(s), {len(graphs)} commit graph(s), "
          f"{sum(len(g['prs']) for g in graphs.values())} PR(s), "
          f"{sum(len(g['sync']) for g in graphs.values())} push/pull event(s), opens on {default} -> {args.out}")
    if args.open:
        subprocess.run(["open", args.out], check=False)


def _whoami(port, timeout):
    """'ours' when a git-timeline server answers on `port`, else 'foreign'."""
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/whoami", timeout=timeout) as r:
            return "ours" if json.loads(r.read().decode("utf-8")).get("app") == "git-timeline" else "foreign"
    except (urllib.error.URLError, OSError, ValueError):
        return "foreign"


def pick_port(base, span=PORT_SPAN, timeout=1.0):
    """(port, 'serve'|'reuse'): the first free port from `base`, or a git-timeline already on one.

    Ownership is settled by asking the server, like the mow tracker's port picker:
    a port held by anything that is not a git-timeline is stepped over, never taken
    or killed, and one that is a git-timeline is reused rather than doubled.
    """
    for port in range(base, base + span):
        with socket.socket() as so:
            # Probe the way the server will bind (HTTPServer sets allow_reuse_address): a port a
            # stopped server left in TIME_WAIT is free to it, and must be free here too.
            so.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                so.bind(("127.0.0.1", port))
                return port, "serve"
            except OSError:
                pass
        if _whoami(port, timeout) == "ours":
            return port, "reuse"
    raise SystemExit(f"git-timeline: no free port in {base}-{base + span - 1}")


def serve(args):
    """The page, live: it fetches data.json on load and every DATA_TTL seconds after.

    Bound to 127.0.0.1 and answering five paths only. It never serves a directory,
    because the log and ~/.claude beside it are nobody else's business.
    """
    port, state = pick_port(args.port or HOME_PORT, span=1 if args.port else PORT_SPAN)
    url = f"http://127.0.0.1:{port}/git-timeline.html"
    if state == "reuse":
        print(f"git-timeline: already serving {url}", flush=True)
        if args.open:
            subprocess.run(["open", url], check=False)
        return
    with open(os.path.join(HERE, "git-timeline.html"), encoding="utf-8") as fh:
        page = fh.read().replace("/*__LIVE__*/false", "/*__LIVE__*/true").encode("utf-8")
    with open(os.path.join(HERE, "git-timeline-guide.html"), encoding="utf-8") as fh:
        guide = fh.read().encode("utf-8")
    pages = {"/": page, "/git-timeline.html": page, "/git-timeline-guide.html": guide}
    whoami = json.dumps({"app": "git-timeline", "log": args.log}).encode("utf-8")
    cache, memo, lock = {"at": 0.0, "body": None}, load_memo(args.cache), threading.Lock()

    def data_body():
        with lock:
            if cache["body"] is None or time.time() - cache["at"] > DATA_TTL:
                cache["body"] = json.dumps(build_data(args, memo), ensure_ascii=False,
                                           separators=(",", ":")).encode("utf-8")
                cache["at"] = time.time()
                save_memo(memo, args.cache)
            return cache["body"]

    class Handler(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            path = urllib.parse.urlsplit(self.path).path
            if path in pages:
                self._send(200, "text/html; charset=utf-8", pages[path])
            elif path == "/data.json":
                self._send(200, "application/json; charset=utf-8", data_body())
            elif path == "/whoami":
                self._send(200, "application/json", whoami)
            else:
                self._send(404, "text/plain; charset=utf-8", b"not found")

        def _send(self, code, ctype, body):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *a):
            pass                    # a request line per 30-second poll is noise

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    # Build the first payload now, not on the first page load: GitHub makes it the slow one.
    threading.Thread(target=data_body, daemon=True).start()
    print(f"git-timeline: serving {url} (bound to 127.0.0.1:{port}; Ctrl-C stops it)", flush=True)
    if args.open:
        subprocess.run(["open", url], check=False)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    ap = argparse.ArgumentParser(prog="git-timeline", description=__doc__.split("\n\n")[0])
    ap.add_argument("cmd", choices=["backfill", "html", "serve"])
    ap.add_argument("--log", default=git_ops.log_path())
    ap.add_argument("--projects", default=os.path.join(CLAUDE, "projects"))
    ap.add_argument("--out", default=os.path.join(CLAUDE, "git-timeline.html"))
    ap.add_argument("--repo")
    ap.add_argument("--open", action="store_true")
    ap.add_argument("--no-prs", action="store_true")
    ap.add_argument("--port", type=int)
    ap.add_argument("--cache", default=os.path.join(CLAUDE, "git-timeline-cache.json"))
    args = ap.parse_args()
    {"backfill": backfill, "html": html, "serve": serve}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
