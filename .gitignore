# Machine-specific config — never committed, this is what keeps the repo publishable
local.config.json

.backups/
# mow's go mode creates one worktree per isolated lane here, so this fills up on
# every parallel run. Scoped to worktrees/ rather than .claude/ so real config in
# that directory stays visible to git.
.claude/worktrees/

# mow's board is served from docs/plans/ and copied fresh from the skill on every
# `/mow go`, so these two are generated, never authored. Anchored with a leading
# slash on purpose: an unanchored `tracker.html` would also swallow
# skills/mow/tracker.html — the source template every board is copied from — and
# the per-run dispatch/tracker.html files older runs still track.
# dispatch/tracker.json is deliberately NOT here: that one is the run's record.
/docs/plans/tracker.html
/docs/plans/.board

# Per-run activity trails, written by the stamp-tracker hook on every tool call.
# Untracked 2026-09-01: they churn constantly and were tracked inconsistently
# across stems. Cost, recorded rather than discovered later: the board derives
# "active time" by intersecting agent spans with this trail, so an archived run
# rendered from a fresh clone falls back to wall clock — the number the trail was
# introduced to replace. Local boards are unaffected; the files stay on disk.
**/dispatch/.activity

# Spawn records written by the PreToolUse hook. Untracked 2026-09-01 alongside
# .activity, and cheaper to lose: board_table.py never reads this file — the
# orchestrator copies agent started/ended into tracker.json, which stays tracked.
# Only a post-hoc audit run from a fresh clone loses the hook's own record to
# cross-check those times against.
**/dispatch/.agent-times.json
.DS_Store
__pycache__/
*.pyc
.pytest_cache/
taskman/.venv/

# Brainstorm ledger lives in the private dotfiles-ai repo (enterprise context)
docs/brainstorms/
